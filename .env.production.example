# ─────────────────────────────────────────────────────────────────────────────
# Plantilla de producción. NO contiene valores reales: cada secreto se completa
# en el servidor desde el gestor de secretos (ver docs/despliegue.md, "Secretos").
# El archivo final (/var/www/erp/.env) queda con permisos 600 y dueño "erp".
# ─────────────────────────────────────────────────────────────────────────────
APP_NAME="OBMAX Sistema de Gestión"
APP_ENV=production
APP_DEBUG=false
# php artisan key:generate --show (una sola vez). Si se pierde, no se pueden leer los
# secretos cifrados de integraciones ni los documentos de RRHH: guárdala en el gestor.
APP_KEY=
APP_TIMEZONE=America/Santiago
APP_URL=https://erp.ejemplo.cl
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CL
BCRYPT_ROUNDS=12

# Logs JSON (una línea por evento) en storage/logs/erp-AAAA-MM-DD.log
LOG_CHANNEL=stack
LOG_STACK=json
LOG_LEVEL=info
LOG_DAILY_DAYS=90

# Base de datos: la app usa erp_app (sujeto a RLS); erp_owner solo para migraciones.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=erp
DB_USERNAME=erp_app
DB_PASSWORD=
DB_OWNER_USERNAME=erp_owner
DB_OWNER_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=720
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=erp.ejemplo.cl

CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

# Correo transaccional (invitaciones, alertas, cotizaciones). SMTP del proveedor elegido.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-responder@obramax.cl"
MAIL_FROM_NAME="${APP_NAME}"

# Firma de la exportación de configuración entre ambientes (distinta en cada ambiente).
CONFIG_EXPORT_KEY=

# Tiempo real (Reverb detrás de nginx en /app). php artisan reverb:install genera ID/clave/secreto.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=erp.ejemplo.cl
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Archivo frío de la política de retención (local o S3 con versionado y Object Lock).
ARCHIVO_DISK_DRIVER=local
ARCHIVO_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_ENDPOINT=

# ── Integraciones ──────────────────────────────────────────────────────────────
# Clase del adaptador por integración. Vacío = simulado. Al conectar un proveedor
# real, pon aquí la clase que implementa la interfaz (ver config/integraciones.php).
INTEGRACION_DTE=
INTEGRACION_PBX=
INTEGRACION_WHATSAPP=
INTEGRACION_META_ADS=
INTEGRACION_LINKEDIN=
INTEGRACION_IA=
INTEGRACION_MAPAS=
INTEGRACION_FIRMA=
# Los tokens de envío (WhatsApp, Meta, LinkedIn, IA, mapas, DTE) NO van aquí: se
# guardan cifrados en Configuración → Integraciones. Aquí solo lo que validan los webhooks:
PBX_WEBHOOK_SECRET=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
